---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import { PUB_TYPES } from '../content.config';
import { assignCiteKeys, pubId } from '../lib/bibtex';

const GROUPS: Record<(typeof PUB_TYPES)[number], string> = {
  journal: 'Peer-reviewed journal articles',
  chapter: 'Book chapters',
  thesis: 'Thesis',
  report: 'Technical reports',
  conference: 'Conference papers',
  poster: 'Conference posters',
};

const all = await getCollection('publications');

// Newest first within each group; stable by title for same-year entries.
const sorted = all
  .map((e) => e.data)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));

const groups = PUB_TYPES.map((type) => ({
  type,
  label: GROUPS[type],
  items: sorted.filter((p) => p.type === type),
})).filter((g) => g.items.length > 0);

// Cite keys must be unique across the whole list, so they are assigned once
// here and handed to each entry rather than derived per-entry.
const citeKeys = assignCiteKeys(sorted);

const total = sorted.length;
const totalCitations = sorted.reduce((sum, p) => sum + (p.citations ?? 0), 0);
const firstAuthor = sorted.filter((p) => /^Lucas,/.test(p.authors[0])).length;
const lastUpdated = sorted
  .map((p) => p.citations_updated)
  .filter(Boolean)
  .sort()
  .at(-1);

const SITE = Astro.site?.href ?? 'https://greglucas.github.io/';

/**
 * Structured data describing each publication as a ScholarlyArticle, so search
 * engines index them as papers rather than as a wall of text. Emitted as an
 * ItemList to keep the page to a single JSON-LD block.
 */
const publicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Publications of Greg M. Lucas',
  numberOfItems: total,
  itemListElement: sorted.map((p, i) => {
    const article: Record<string, unknown> = {
      '@type':
        p.type === 'chapter'
          ? 'Chapter'
          : p.type === 'thesis'
            ? 'Thesis'
            : p.type === 'report'
              ? 'Report'
              : 'ScholarlyArticle',
      name: p.title,
      author: p.authors.map((a) => {
        const [family, given] = a.split(',').map((s) => s.trim());
        return { '@type': 'Person', familyName: family, givenName: given ?? undefined, name: a };
      }),
      datePublished: String(p.year),
    };
    if (p.doi) {
      article.identifier = `https://doi.org/${p.doi}`;
      article.sameAs = `https://doi.org/${p.doi}`;
      article.url = `https://doi.org/${p.doi}`;
    } else if (p.url) {
      article.url = p.url;
    }
    if (p.venue) {
      article.isPartOf = { '@type': 'Periodical', name: p.venue };
    }
    if (p.volume !== undefined) article.volumeNumber = String(p.volume);
    if (p.issue !== undefined) article.issueNumber = String(p.issue);
    if (p.pages) {
      const [start, end] = p.pages.split('-');
      article.pageStart = start;
      if (end) article.pageEnd = end;
    }
    if (p.institution) {
      article.publisher = { '@type': 'Organization', name: p.institution };
    }
    return { '@type': 'ListItem', position: i + 1, item: article };
  }),
};
---

<Base
  title="Publications"
  description="Peer-reviewed journal articles, book chapters, reports, conference papers and posters by Greg M. Lucas, covering space weather, geoelectric hazards and the global electric circuit."
>
  <div class="page">
    <div class="section-head">
      <span class="eyebrow">Space weather &middot; Geoelectric hazards &middot; Global electric circuit</span>
      <h1>Publications</h1>
      <p class="lede">
        {total} publications spanning atmospheric electricity, geomagnetic hazard analysis and
        nuclear launch safety. Metadata is generated from each paper's DOI, so it matches the
        publisher of record.
      </p>
    </div>

    <dl class="stats">
      <div>
        <dt>Publications</dt>
        <dd>{total}</dd>
      </div>
      <div>
        <dt>First author</dt>
        <dd>{firstAuthor}</dd>
      </div>
      {
        totalCitations > 0 && (
          <div>
            <dt>Citations</dt>
            <dd>{totalCitations.toLocaleString('en-US')}</dd>
          </div>
        )
      }
    </dl>

    <div class="btn-row profiles">
      <a class="btn btn-ghost" href="https://scholar.google.com/citations?user=0CWZSCUAAAAJ" rel="noopener">
        Google Scholar
      </a>
      <a class="btn btn-ghost" href="https://orcid.org/0000-0003-1331-1863" rel="noopener">
        ORCID 0000-0003-1331-1863
      </a>
      <a class="btn btn-ghost" href="/publications.bib" download="lucas-publications.bib">
        Download all as BibTeX
      </a>
    </div>

    <nav class="jump" aria-label="Publication sections">
      {groups.map((g) => <a href={`#${g.type}`}>{g.label}</a>)}
    </nav>

    {
      groups.map((g) => (
        <section class="group" id={g.type}>
          <h2>
            {g.label} <span class="count">{g.items.length}</span>
          </h2>
          <ul class="pub-list">
            {g.items.map((pub) => (
              <Publication pub={pub} citeKey={citeKeys.get(pubId(pub))} />
            ))}
          </ul>
        </section>
      ))
    }

    {
      totalCitations > 0 && (
        <p class="footnote">
          Citation counts come from <a href="https://openalex.org" rel="noopener">OpenAlex</a> and are
          refreshed weekly{lastUpdated ? ` (last updated ${lastUpdated})` : ''}. They will differ from
          Google Scholar, which indexes a broader and less curated set of sources.
        </p>
      )
    }
  </div>

  <script is:inline set:html={JSON.stringify(publicationSchema)} type="application/ld+json" />

  <script is:inline>
    // One delegated listener rather than 44 inline handlers.
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('.copy-bib');
      if (!button) return;

      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(button.dataset.bib);
        button.textContent = 'Copied';
      } catch {
        // Clipboard API needs a secure context and permission; if it is
        // refused, select the text so the reader can copy it themselves.
        const code = button.parentElement.querySelector('code');
        if (code) {
          const range = document.createRange();
          range.selectNodeContents(code);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
        }
        button.textContent = 'Press Ctrl/Cmd+C';
      }
      setTimeout(() => {
        button.textContent = original;
      }, 2000);
    });
  </script>
</Base>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-bottom: 1.5rem;
    padding: 1.1rem 1.35rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .stats dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .stats dd {
    margin: 0.1rem 0 0;
    font-size: 1.65rem;
    font-weight: 650;
    line-height: 1.1;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .profiles {
    margin-bottom: 2rem;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .jump a {
    text-decoration: none;
    font-weight: 550;
  }

  .jump a:hover {
    text-decoration: underline;
  }

  .group {
    margin-top: 3rem;
  }

  .group h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--brand);
    margin-bottom: 0.5rem;
  }

  .count {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-faint);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }

  .pub-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footnote {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-faint);
    max-width: var(--measure);
  }
</style>
